# Database connection (PostgreSQL supported; defaults automatically to local SQLite if empty)
DATABASE_URL=

# Port configuration
PORT=3001
CLIENT_PORT=3000

# Session / JWT security
SESSION_SECRET=change-this-to-a-secure-random-secret-in-production
JWT_SECRET=change-this-to-a-secure-jwt-secret-in-production

# AI / LLM Configuration (supports OpenAI, Gemini, Anthropic, or simulated provider)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
VECTOR_DATABASE_URL=

# App Environment
NODE_ENV=development
